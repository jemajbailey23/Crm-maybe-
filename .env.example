# Postgres connection strings. For local dev, point both at a local
# Postgres instance (same value is fine for both). On Supabase, use the
# *pooled* "Transaction" connection string (port 6543, with
# ?pgbouncer=true) for DATABASE_URL, and the *direct* connection string
# (port 5432) for DIRECT_URL — see README for where to find these.
DATABASE_URL="postgresql://postgres:password@localhost:5432/crm_dev"
DIRECT_URL="postgresql://postgres:password@localhost:5432/crm_dev"

# Generate with: openssl rand -hex 32
AUTH_SECRET="replace-with-a-random-secret"

# Used to build links in emails (e.g. password reset). Set to your real
# deployed URL in production, e.g. https://your-app.vercel.app
APP_URL="http://localhost:3000"

# Optional: lets the CRM send real emails (password reset) via Gmail.
# If unset, reset links are logged to the server console instead —
# fine for local dev, but you'll want these set in production.
# GMAIL_USER="you@gmail.com"
# GMAIL_APP_PASSWORD="16-character app password, not your Gmail login password"
