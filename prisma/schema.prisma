// Prisma schema for Bailey Ventures Digital CRM

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  failedLoginAttempts Int       @default(0)
  lockedUntil         DateTime?

  // Weekly booking availability: JSON array of
  // { dayOfWeek: 0-6 (Sun-Sat), start: "HH:MM", end: "HH:MM" }
  weeklyAvailability Json?
  bookingSlotMinutes Int    @default(30)
  bookingTimezone    String @default("America/New_York")

  tasks      Task[]
  activities Activity[]
  passwordResetTokens PasswordResetToken[]
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String
}

model Company {
  id        String   @id @default(cuid())
  name      String
  website   String?
  phone     String?
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  contacts Contact[]
  deals    Deal[]
}

enum ContactStatus {
  LEAD
  CLIENT
}

model Contact {
  id        String        @id @default(cuid())
  firstName String
  lastName  String
  email     String?
  phone     String?
  title     String?
  notes     String?
  tags      String? // comma-separated for simplicity in v1
  status    ContactStatus @default(LEAD)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  company   Company? @relation(fields: [companyId], references: [id], onDelete: SetNull)
  companyId String?

  deals      Deal[]
  tasks      Task[]
  activities Activity[]
  bookings   Booking[]
}

model Booking {
  id        String   @id @default(cuid())
  startsAt  DateTime
  endsAt    DateTime
  name      String
  email     String
  notes     String?
  createdAt DateTime @default(now())

  contact   Contact? @relation(fields: [contactId], references: [id], onDelete: SetNull)
  contactId String?
}

enum DealStage {
  NEW
  CONTACTED
  PROPOSAL
  WON
  LOST
}

model Deal {
  id          String    @id @default(cuid())
  title       String
  value       Float? // deal value in dollars
  stage       DealStage @default(NEW)
  isRecurring Boolean   @default(false) // recurring/retainer revenue vs one-time
  notes       String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  wonAt       DateTime? // set when stage transitions to WON, for accurate monthly reporting

  contact   Contact? @relation(fields: [contactId], references: [id], onDelete: SetNull)
  contactId String?

  company   Company? @relation(fields: [companyId], references: [id], onDelete: SetNull)
  companyId String?

  tasks      Task[]
  activities Activity[]
}

enum TaskStatus {
  OPEN
  DONE
}

model Task {
  id        String     @id @default(cuid())
  title     String
  dueDate   DateTime?
  status    TaskStatus @default(OPEN)
  notes     String?
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  assignedTo   User?   @relation(fields: [assignedToId], references: [id], onDelete: SetNull)
  assignedToId String?

  contact   Contact? @relation(fields: [contactId], references: [id], onDelete: SetNull)
  contactId String?

  deal   Deal?   @relation(fields: [dealId], references: [id], onDelete: SetNull)
  dealId String?
}

enum ActivityType {
  NOTE
  CALL
  EMAIL
  MEETING
}

model Activity {
  id        String       @id @default(cuid())
  type      ActivityType
  summary   String
  occurredAt DateTime    @default(now())
  createdAt DateTime     @default(now())

  contact   Contact? @relation(fields: [contactId], references: [id], onDelete: SetNull)
  contactId String?

  deal   Deal?   @relation(fields: [dealId], references: [id], onDelete: SetNull)
  dealId String?

  createdBy   User?   @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdById String?
}
