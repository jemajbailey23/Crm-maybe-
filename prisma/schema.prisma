// Prisma schema for Bailey Ventures Digital CRM

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  failedLoginAttempts Int       @default(0)
  lockedUntil         DateTime?

  // Weekly booking availability: JSON array of
  // { dayOfWeek: 0-6 (Sun-Sat), start: "HH:MM", end: "HH:MM" }
  weeklyAvailability Json?
  bookingSlotMinutes Int    @default(30)
  bookingTimezone    String @default("America/New_York")

  // Used to estimate profit on the financial dashboard (revenue * margin).
  // No expense tracking exists yet, so this is a manually-set assumption.
  profitMarginPercent Int @default(70)

  // Settings
  brandColor         String @default("indigo")
  defaultLandingPage String @default("/dashboard")

  tasks               Task[]
  activities          Activity[]
  passwordResetTokens PasswordResetToken[]
  goals               Goal[]
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String
}

model Company {
  id        String   @id @default(cuid())
  name      String
  website   String?
  phone     String?
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  contacts Contact[]
  deals    Deal[]
}

enum ContactStatus {
  LEAD
  CLIENT
}

enum Priority {
  LOW
  MEDIUM
  HIGH
}

enum ContractStatus {
  NOT_SENT
  SENT
  SIGNED
  EXPIRED
}

enum BillingType {
  ONE_TIME
  MONTHLY
}

enum InvoiceStatus {
  DRAFT
  SENT
  PAID
  OVERDUE
}

model Contact {
  id        String        @id @default(cuid())
  firstName String
  lastName  String
  email     String?
  phone     String?
  title     String?
  notes     String?
  tags      String? // comma-separated for simplicity in v1
  status    ContactStatus @default(LEAD)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  // Business information
  businessName          String?
  industry              String?
  website               String?
  googleBusinessProfile String?
  facebook              String?
  instagram             String?
  address               String?

  // Sales information
  leadSource         String?
  pipelineStage      DealStage @default(NEW)
  estimatedDealValue Float?
  monthlyValue       Float?
  leadScore          Int? // 1-100
  closingProbability Int? // 0-100
  priority           Priority  @default(MEDIUM)
  nextFollowUpAt     DateTime?

  // Pain points
  currentProblems String?
  desiredOutcome  String?
  competitors     String?

  // Client workspace: contract + website information
  contractStatus      ContractStatus @default(NOT_SENT)
  domain              String?
  hostingProvider     String?
  analyticsAccount    String?
  googleSearchConsole String?

  company   Company? @relation(fields: [companyId], references: [id], onDelete: SetNull)
  companyId String?

  // Set the first time a Stripe payment is matched to this contact (by
  // email), so future payments from the same Stripe customer attach here
  // even if the contact's email is later changed.
  stripeCustomerId String? @unique

  deals       Deal[]
  tasks       Task[]
  activities  Activity[]
  bookings    Booking[]
  attachments Attachment[]
  projects    Project[]
  services    Service[]
  invoices    Invoice[]
  links       ImportantLink[]
  credentials Credential[]
}

model Service {
  id          String      @id @default(cuid())
  name        String
  billingType BillingType @default(ONE_TIME)
  amount      Float?
  createdAt   DateTime    @default(now())

  // Set once this recurring service is canceled (from Stripe or manually),
  // so it drops out of active-service lists while still counting toward
  // historical MRR for the months it was actually active.
  endedAt DateTime?

  // Set when this service was created/updated from a Stripe subscription
  // webhook event, so replayed events update the same row instead of
  // creating a second one, and the UI can show it was synced rather than
  // entered manually.
  stripeSubscriptionId String? @unique

  contact   Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)
  contactId String
}

model Invoice {
  id          String        @id @default(cuid())
  description String
  amount      Float
  status      InvoiceStatus @default(DRAFT)
  issuedDate  DateTime?
  dueDate     DateTime?
  paidAt      DateTime?
  createdAt   DateTime      @default(now())

  // Set when this invoice was created/updated from a Stripe webhook event,
  // so replayed/duplicate events update the same row instead of creating
  // a second one, and the UI can show it was synced rather than manual.
  stripeInvoiceId String? @unique

  // Cents refunded via Stripe are netted out of revenue reporting (amount -
  // refundedAmount) without inventing a new "refunded" status, since a
  // partially-refunded invoice is still meaningfully "paid".
  refundedAmount Float     @default(0)
  refundedAt     DateTime?

  contact   Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)
  contactId String
}

model ImportantLink {
  id        String   @id @default(cuid())
  label     String
  url       String
  createdAt DateTime @default(now())

  contact   Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)
  contactId String
}

model Credential {
  id        String   @id @default(cuid())
  label     String
  username  String?
  secret    String // encrypted (AES-256-GCM), never stored in plaintext
  url       String?
  notes     String?
  createdAt DateTime @default(now())

  contact   Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)
  contactId String
}

model Attachment {
  id        String   @id @default(cuid())
  filename  String
  path      String // storage object key, used to delete from the bucket
  url       String
  sizeBytes Int
  mimeType  String?
  createdAt DateTime @default(now())

  contact   Contact? @relation(fields: [contactId], references: [id], onDelete: Cascade)
  contactId String?

  project   Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId String?

  task   Task?   @relation(fields: [taskId], references: [id], onDelete: Cascade)
  taskId String?
}

enum ProjectStatus {
  NOT_STARTED
  IN_PROGRESS
  ON_HOLD
  COMPLETED
}

model Project {
  id        String        @id @default(cuid())
  name      String // e.g. Website, SEO, AI Automation, Google Business Profile, CRM Setup, Branding
  status    ProjectStatus @default(NOT_STARTED)
  progress  Int           @default(0) // 0-100
  dueDate   DateTime?
  priority  Priority      @default(MEDIUM)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  contact   Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)
  contactId String

  tasks       Task[]
  checklist   ChecklistItem[]
  attachments Attachment[]
  activities  Activity[]
  timeEntries TimeEntry[]
}

model ChecklistItem {
  id        String   @id @default(cuid())
  label     String
  done      Boolean  @default(false)
  createdAt DateTime @default(now())

  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId String
}

model TimeEntry {
  id          String   @id @default(cuid())
  minutes     Int
  description String?
  occurredAt  DateTime @default(now())
  createdAt   DateTime @default(now())

  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId String
}

model Booking {
  id        String   @id @default(cuid())
  // Unique so two visitors racing for the same slot can't both succeed —
  // the availability check that runs before this is a read, not a lock,
  // so this is the actual guard against a double-booked slot.
  startsAt  DateTime @unique
  endsAt    DateTime
  name      String
  email     String
  notes     String?
  createdAt DateTime @default(now())

  contact   Contact? @relation(fields: [contactId], references: [id], onDelete: SetNull)
  contactId String?
}

enum DealStage {
  NEW
  CONTACTED
  PROPOSAL
  WON
  LOST
}

model Deal {
  id          String    @id @default(cuid())
  title       String
  value       Float? // deal value in dollars
  stage       DealStage @default(NEW)
  isRecurring Boolean   @default(false) // recurring/retainer revenue vs one-time
  notes       String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  wonAt       DateTime? // set when stage transitions to WON, for accurate monthly reporting

  contact   Contact? @relation(fields: [contactId], references: [id], onDelete: SetNull)
  contactId String?

  company   Company? @relation(fields: [companyId], references: [id], onDelete: SetNull)
  companyId String?

  tasks      Task[]
  activities Activity[]
}

enum TaskStatus {
  OPEN
  DONE
}

enum TaskRecurrence {
  NONE
  DAILY
  WEEKLY
  MONTHLY
}

model Task {
  id         String         @id @default(cuid())
  title      String
  dueDate    DateTime?
  status     TaskStatus     @default(OPEN)
  notes      String?
  priority   Priority       @default(MEDIUM)
  recurrence TaskRecurrence @default(NONE)
  labels     String? // comma-separated for simplicity, same pattern as Contact.tags
  progress   Int            @default(0) // 0-100
  overdueNotified Boolean   @default(false) // guards the Task Overdue automation from re-firing
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt

  assignedTo   User?   @relation(fields: [assignedToId], references: [id], onDelete: SetNull)
  assignedToId String?

  contact   Contact? @relation(fields: [contactId], references: [id], onDelete: SetNull)
  contactId String?

  deal   Deal?   @relation(fields: [dealId], references: [id], onDelete: SetNull)
  dealId String?

  project   Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  projectId String?

  attachments Attachment[]
}

enum ActivityType {
  NOTE
  CALL
  EMAIL
  MEETING
  SMS
  FACEBOOK_MESSAGE
  DEMO
  PROPOSAL
}

model Activity {
  id         String       @id @default(cuid())
  type       ActivityType
  summary    String
  missed     Boolean      @default(false) // only meaningful when type is CALL
  occurredAt DateTime     @default(now())
  createdAt  DateTime     @default(now())

  contact   Contact? @relation(fields: [contactId], references: [id], onDelete: SetNull)
  contactId String?

  deal   Deal?   @relation(fields: [dealId], references: [id], onDelete: SetNull)
  dealId String?

  project   Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  projectId String?

  createdBy   User?   @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdById String?
}

enum KnowledgeCategory {
  SALES_SCRIPTS
  DISCOVERY_QUESTIONS
  SEO_SOPS
  AI_AUTOMATION_SOPS
  WEBSITE_SOPS
  PROPOSAL_TEMPLATES
  EMAIL_TEMPLATES
  PROMPT_LIBRARY
  OBJECTION_HANDLING
  BUSINESS_RESOURCES
}

model KnowledgeArticle {
  id        String            @id @default(cuid())
  title     String
  category  KnowledgeCategory
  content   String
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt
}

enum GoalMetric {
  CALLS
  MEETINGS
  DEMOS
  PROPOSALS
  CLIENTS_CLOSED
  REVENUE
}

enum GoalPeriod {
  WEEKLY
  MONTHLY
}

model Goal {
  id        String     @id @default(cuid())
  metric    GoalMetric
  period    GoalPeriod
  target    Float      @default(0)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String

  @@unique([userId, metric, period])
}

enum AutomationTrigger {
  LEAD_CREATED
  PROPOSAL_SENT
  INVOICE_PAID
  WEBSITE_PUBLISHED
  CLIENT_SIGNED
  TASK_OVERDUE
  REVIEW_REQUEST
  MISSED_CALL
  APPOINTMENT_BOOKED
}

enum AutomationActionType {
  CREATE_TASK
  SEND_EMAIL
  WEBHOOK
}

// Who a SEND_EMAIL action's message goes to. OWNER (the default, and the
// only option that previously existed) notifies the CRM owner. CONTACT
// sends to the contact linked to the triggering event instead — e.g. a
// booking confirmation the client themselves receives.
enum AutomationEmailRecipient {
  OWNER
  CONTACT
}

enum AutomationRunStatus {
  SUCCESS
  FAILED
}

model AutomationRule {
  id         String               @id @default(cuid())
  name       String
  trigger    AutomationTrigger
  actionType AutomationActionType
  enabled    Boolean              @default(true)
  createdAt  DateTime             @default(now())
  updatedAt  DateTime             @updatedAt

  // CREATE_TASK config
  taskTitle     String?
  taskDueInDays Int?

  // SEND_EMAIL config
  emailRecipient AutomationEmailRecipient @default(OWNER)
  emailSubject   String?
  emailBody      String?

  // WEBHOOK config
  webhookUrl String?

  runs AutomationRun[]
}

model AutomationRun {
  id        String              @id @default(cuid())
  status    AutomationRunStatus @default(SUCCESS)
  summary   String
  error     String?
  createdAt DateTime            @default(now())

  rule   AutomationRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)
  ruleId String
}

// Custom display label for one of the fixed DealStage values. The stage set
// itself (NEW/CONTACTED/PROPOSAL/WON/LOST) stays fixed since WON/LOST drive
// revenue and automation logic throughout the app — only the label is
// customizable.
model PipelineStageLabel {
  id    String    @id @default(cuid())
  stage DealStage @unique
  label String
}

// Suggested service names shown when adding a service to a client — services
// themselves stay free text, this just powers the autocomplete list.
model ServiceType {
  id        String   @id @default(cuid())
  name      String   @unique
  createdAt DateTime @default(now())
}

// Suggested task labels shown when tagging a task — Task.labels stays free
// text, this just powers the autocomplete list.
model TaskLabelPreset {
  id        String   @id @default(cuid())
  name      String   @unique
  createdAt DateTime @default(now())
}
