// Prisma schema for Bailey Ventures Digital CRM

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  failedLoginAttempts Int       @default(0)
  lockedUntil         DateTime?

  // Weekly booking availability: JSON array of
  // { dayOfWeek: 0-6 (Sun-Sat), start: "HH:MM", end: "HH:MM" }
  weeklyAvailability Json?
  bookingSlotMinutes Int    @default(30)
  bookingTimezone    String @default("America/New_York")

  // Used to estimate profit on the financial dashboard (revenue * margin).
  // No expense tracking exists yet, so this is a manually-set assumption.
  profitMarginPercent Int @default(70)

  // Settings
  brandColor         String @default("indigo")
  defaultLandingPage String @default("/dashboard")

  // Stage 7: when set, prospect-facing booking links (the shareable link
  // shown in Booking settings, and every link inside confirmation/reminder
  // emails) use this instead of the raw APP_URL/Vercel domain. Actually
  // pointing a custom domain at this deployment is a Vercel dashboard step
  // outside this app's code — this field only controls what URL gets
  // *displayed and emailed* once that's done.
  bookingBrandedUrl String?

  tasks               Task[]
  activities          Activity[]
  passwordResetTokens PasswordResetToken[]
  goals               Goal[]
  assignedDeals       Deal[]
  ownedArticles       KnowledgeArticle[]
  articleRevisions    KnowledgeArticleRevision[]
  aiQueryLogs         AiQueryLog[]
  ownedProjects       Project[]
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String
}

model Company {
  id        String   @id @default(cuid())
  name      String
  website   String?
  phone     String?
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  contacts    Contact[]
  deals       Deal[]
  tasks       Task[]
  projects    Project[]
  nextActions NextBestActionItem[]
  bookings    Booking[]
}

enum ContactStatus {
  LEAD
  CLIENT
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum ContractStatus {
  NOT_SENT
  SENT
  SIGNED
  EXPIRED
}

enum BillingType {
  ONE_TIME
  MONTHLY
}

enum InvoiceStatus {
  DRAFT
  SENT
  PAID
  OVERDUE
}

model Contact {
  id        String        @id @default(cuid())
  firstName String
  lastName  String
  email     String?
  phone     String?
  title     String?
  notes     String?
  tags      String? // comma-separated for simplicity in v1
  status    ContactStatus @default(LEAD)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  // Business information
  businessName          String?
  industry              String?
  website               String?
  googleBusinessProfile String?
  facebook              String?
  instagram             String?
  address               String?

  // Sales information
  leadSource         String?
  pipelineStage      DealStage @default(NEW_LEAD)
  estimatedDealValue Float?
  monthlyValue       Float?
  leadScore          Int? // 1-100
  closingProbability Int? // 0-100
  priority           Priority  @default(MEDIUM)
  nextFollowUpAt     DateTime?

  // Pain points
  currentProblems String?
  desiredOutcome  String?
  competitors     String?

  // Client workspace: contract + website information
  contractStatus      ContractStatus @default(NOT_SENT)
  domain              String?
  hostingProvider     String?
  analyticsAccount    String?
  googleSearchConsole String?

  company   Company? @relation(fields: [companyId], references: [id], onDelete: SetNull)
  companyId String?

  // Set the first time a Stripe payment is matched to this contact (by
  // email), so future payments from the same Stripe customer attach here
  // even if the contact's email is later changed.
  stripeCustomerId String? @unique

  deals       Deal[]
  tasks       Task[]
  activities  Activity[]
  bookings    Booking[]
  attachments Attachment[]
  projects    Project[]
  services    Service[]
  invoices    Invoice[]
  links       ImportantLink[]
  credentials Credential[]
  nextActions NextBestActionItem[]

  knowledgeArticles    KnowledgeArticle[]
  failedPayments       FailedPayment[]
  reconciliationAlerts ReconciliationAlert[]
  aiQueryLogs          AiQueryLog[]
}

model Service {
  id          String      @id @default(cuid())
  name        String
  billingType BillingType @default(ONE_TIME)
  amount      Float?
  createdAt   DateTime    @default(now())

  // Set once this recurring service is canceled (from Stripe or manually),
  // so it drops out of active-service lists while still counting toward
  // historical MRR for the months it was actually active.
  endedAt DateTime?

  // Set when this service was created/updated from a Stripe subscription
  // webhook event, so replayed events update the same row instead of
  // creating a second one, and the UI can show it was synced rather than
  // entered manually.
  stripeSubscriptionId String? @unique

  contact   Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)
  contactId String

  mrrEvents ServiceMrrEvent[]
}

// One row per delivered Stripe webhook event, keyed by Stripe's own event
// id. Checked (and inserted) before any event is processed — see
// api/webhooks/stripe/route.ts — so a redelivered event (Stripe retries on
// timeout/5xx, and can also just send the same event twice) is a no-op the
// second time: no duplicate DB writes, and critically, no duplicate
// automation firing (e.g. a second "invoice paid" email), which a plain
// upsert alone doesn't prevent since upserts are safe for data but not for
// side effects.
model StripeEvent {
  id          String   @id // Stripe event id, e.g. "evt_..." — the dedup key itself
  type        String
  processedAt DateTime @default(now())
}

// invoice.payment_failed / charge.failed — there was previously no record
// of failed payment attempts at all. stripeChargeId is unique so a
// redelivered failure webhook updates the same row instead of duplicating.
model FailedPayment {
  id              String   @id @default(cuid())
  stripeChargeId  String?  @unique
  stripeInvoiceId String?
  amount          Float
  reason          String?
  occurredAt      DateTime @default(now())

  contact   Contact? @relation(fields: [contactId], references: [id], onDelete: SetNull)
  contactId String?

  @@index([contactId])
  @@index([occurredAt])
}

enum MrrEventType {
  NEW
  EXPANSION
  CONTRACTION
  CHURN
}

// Recurring-revenue movement history. A Service only ever stores its
// *current* amount, so New/Expansion/Contraction/Churned MRR can't be
// computed from Service rows alone — this is the log that makes that
// possible, written whenever syncStripeSubscription sees a subscription
// created, its amount change, or it end. Recorded going forward only —
// amount-change history from before this shipped can't be reconstructed,
// see the Financials audit notes.
model ServiceMrrEvent {
  id          String       @id @default(cuid())
  type        MrrEventType
  amountDelta Float // positive for NEW/EXPANSION, negative for CONTRACTION/CHURN
  occurredAt  DateTime     @default(now())

  service   Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  serviceId String

  @@index([serviceId])
  @@index([occurredAt])
}

enum ReconciliationAlertType {
  STRIPE_PAYMENT_WITHOUT_INVOICE
  INVOICE_PAID_WITHOUT_PAYMENT
  REFUND_WITHOUT_TRANSACTION
  DUPLICATE_EXTERNAL_ID
  SUBSCRIPTION_STATUS_MISMATCH
  DASHBOARD_TOTAL_MISMATCH
}

enum ReconciliationAlertStatus {
  OPEN
  RESOLVED
  IGNORED
}

// Surfaced on the Financials page. dedupeKey is unique so re-running the
// reconciliation checks updates the same alert (and lets it self-resolve
// when the underlying issue is fixed) instead of spawning a fresh
// duplicate row every run.
model ReconciliationAlert {
  id         String                    @id @default(cuid())
  type       ReconciliationAlertType
  status     ReconciliationAlertStatus @default(OPEN)
  message    String
  dedupeKey  String                    @unique
  detectedAt DateTime                  @default(now())
  resolvedAt DateTime?

  contact   Contact? @relation(fields: [contactId], references: [id], onDelete: SetNull)
  contactId String?

  invoice   Invoice? @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
  invoiceId String?

  @@index([status])
}

model Invoice {
  id          String        @id @default(cuid())
  description String
  amount      Float
  status      InvoiceStatus @default(DRAFT)
  issuedDate  DateTime?
  dueDate     DateTime?
  paidAt      DateTime?
  createdAt   DateTime      @default(now())

  // Set when this invoice was created/updated from a Stripe webhook event,
  // so replayed/duplicate events update the same row instead of creating
  // a second one, and the UI can show it was synced rather than manual.
  stripeInvoiceId String? @unique

  // Cents refunded via Stripe are netted out of revenue reporting (amount -
  // refundedAmount) without inventing a new "refunded" status, since a
  // partially-refunded invoice is still meaningfully "paid".
  refundedAmount Float     @default(0)
  refundedAt     DateTime?

  // True when this invoice bills a recurring subscription rather than a
  // one-time charge — set automatically from Stripe's `invoice.subscription`
  // field when synced, or toggled manually for hand-entered invoices. Lets
  // "one-time revenue collected" and "recurring revenue collected" be
  // computed as genuinely separate figures instead of guessed.
  isRecurring Boolean @default(false)

  contact   Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)
  contactId String

  tasks                Task[]
  reconciliationAlerts ReconciliationAlert[]
}

model ImportantLink {
  id        String   @id @default(cuid())
  label     String
  url       String
  createdAt DateTime @default(now())

  contact   Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)
  contactId String
}

model Credential {
  id        String   @id @default(cuid())
  label     String
  username  String?
  secret    String // encrypted (AES-256-GCM), never stored in plaintext
  url       String?
  notes     String?
  createdAt DateTime @default(now())

  contact   Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)
  contactId String
}

model Attachment {
  id        String   @id @default(cuid())
  filename  String
  path      String // storage object key, used to delete from the bucket
  url       String
  sizeBytes Int
  mimeType  String?
  createdAt DateTime @default(now())

  contact   Contact? @relation(fields: [contactId], references: [id], onDelete: Cascade)
  contactId String?

  project   Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId String?

  task   Task?   @relation(fields: [taskId], references: [id], onDelete: Cascade)
  taskId String?

  article   KnowledgeArticle? @relation(fields: [articleId], references: [id], onDelete: Cascade)
  articleId String?
}

// Expanded from 4 values (NOT_STARTED/IN_PROGRESS/ON_HOLD/COMPLETED) to a
// full delivery workflow. Existing rows are remapped on migration:
// ON_HOLD -> PAUSED (closest existing meaning); everything else keeps its
// name. BLOCKED, WAITING_ON_CLIENT, and WAITING_ON_APPROVAL are new,
// distinct statuses a project didn't previously have a way to express.
enum ProjectStatus {
  NOT_STARTED
  PLANNING
  IN_PROGRESS
  WAITING_ON_CLIENT
  WAITING_ON_APPROVAL
  BLOCKED
  QUALITY_REVIEW
  COMPLETED
  PAUSED
  CANCELLED
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

model Project {
  id              String        @id @default(cuid())
  name            String // e.g. Website, SEO, AI Automation, Google Business Profile, CRM Setup, Branding
  status          ProjectStatus @default(NOT_STARTED)
  // Reset every time status changes (see actions.ts) — same convention as
  // Deal.stageEnteredAt. Lets health checks answer "how long has this been
  // waiting on the client/approval" transparently instead of guessing off
  // updatedAt, which changes on any edit.
  statusEnteredAt DateTime      @default(now())
  progress        Int           @default(0) // 0-100, i.e. "completion percentage"

  // Renamed from the original "dueDate" to match the Stage 5 field list —
  // same column, same meaning, just a clearer name now that
  // actualCompletionDate exists alongside it.
  targetCompletionDate DateTime?
  actualCompletionDate DateTime? // set automatically when status first becomes COMPLETED

  priority Priority @default(MEDIUM)

  // health is intentionally NOT a stored column — it's always computed at
  // read time from transparent, inspectable rules (see project-rules.ts),
  // the same way Deal warnings already work in this codebase. Storing a
  // cached health value would let it silently go stale.

  startDate DateTime?

  service String? // free text, e.g. "Local SEO", "Website Build" — same convention as Deal.serviceInterest

  blockedReason String? // populated when status = BLOCKED, same convention as Task.blockedReason
  waitingReason String? // populated when status = WAITING_ON_CLIENT or WAITING_ON_APPROVAL

  hoursBudgeted Float? // hoursTracked is derived from TimeEntry at read time, not duplicated here

  // Manually entered — there's no clean per-project revenue linkage in the
  // schema (Services/Invoices attach to Contact, not Project) to compute
  // profitability from honestly, so this is an estimate the owner enters,
  // not an auto-calculated figure.
  estimatedDeliveryCost  Float?
  estimatedProfitability Float?

  internalNotes     String? // never shown outside the CRM
  clientFacingNotes String? // written as if the client might see it — no client portal exists yet to actually show it

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  contact   Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)
  contactId String

  company   Company? @relation(fields: [companyId], references: [id], onDelete: SetNull)
  companyId String?

  owner   User?   @relation(fields: [ownerId], references: [id], onDelete: SetNull)
  ownerId String?

  // The template this project was created from, if any — kept for
  // reference/reporting even though the generated tasks/approvals are
  // independent rows by that point (editing the template later doesn't
  // retroactively change already-created projects).
  template   ProjectTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)
  templateId String?

  tasks       Task[]
  checklist   ChecklistItem[]
  attachments Attachment[]
  activities  Activity[]
  timeEntries TimeEntry[]
  milestones  ProjectMilestone[]
  approvals   ProjectApproval[]

  @@index([status])
  @@index([companyId])
  @@index([ownerId])
}

model ProjectMilestone {
  id          String    @id @default(cuid())
  title       String
  dueDate     DateTime?
  completedAt DateTime?
  order       Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId String

  @@index([projectId])
}

model ProjectApproval {
  id          String         @id @default(cuid())
  label       String // e.g. "Client sign-off on homepage design"
  status      ApprovalStatus @default(PENDING)
  requestedAt DateTime       @default(now())
  respondedAt DateTime?
  notes       String?
  createdAt   DateTime       @default(now())

  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId String

  @@index([projectId])
}

// A reusable checklist of default work for a kind of engagement (e.g.
// "Website Build") — applied once at project creation to generate real
// Task/TaskDependency/ProjectApproval rows. Editing a template afterward
// never retroactively changes projects already created from it.
model ProjectTemplate {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tasks     ProjectTemplateTask[]
  approvals ProjectTemplateApproval[]
  projects  Project[]
}

model ProjectTemplateTask {
  id                String  @id @default(cuid())
  title             String
  description       String?
  dueDateOffsetDays Int? // days after the project's startDate this task is due
  isQualityControl  Boolean @default(false)
  requiresEvidence  Boolean @default(false)
  order             Int     @default(0)

  template   ProjectTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  templateId String

  // Self-reference within the same template: this task can't start until
  // the referenced template task's generated Task is done. Nullable —
  // most template tasks have no dependency.
  dependsOn    ProjectTemplateTask?  @relation("TemplateTaskDependsOn", fields: [dependsOnId], references: [id], onDelete: SetNull)
  dependsOnId  String?
  dependedOnBy ProjectTemplateTask[] @relation("TemplateTaskDependsOn")

  @@index([templateId])
}

model ProjectTemplateApproval {
  id                String @id @default(cuid())
  label             String
  dueDateOffsetDays Int?
  order             Int    @default(0)

  template   ProjectTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  templateId String

  @@index([templateId])
}

model ChecklistItem {
  id        String   @id @default(cuid())
  label     String
  done      Boolean  @default(false)
  createdAt DateTime @default(now())

  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId String
}

model TimeEntry {
  id          String   @id @default(cuid())
  minutes     Int
  description String?
  occurredAt  DateTime @default(now())
  createdAt   DateTime @default(now())

  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId String
}

// One configurable appointment type a prospect can pick on the public
// booking page. Slug powers per-type share links (/book/[slug]); every
// other field is one of the Stage 7 "each meeting type must support"
// requirements.
model MeetingType {
  id          String  @id @default(cuid())
  name        String
  slug        String  @unique
  description String?
  isActive    Boolean @default(true)
  // Display/creation order on the meeting-type picker and settings list.
  sortOrder   Int     @default(0)

  durationMinutes Int @default(30)

  // Per-type availability override — JSON array of
  // { dayOfWeek: 0-6, start: "HH:MM", end: "HH:MM" }, same shape as
  // User.weeklyAvailability. Null means "use the owner's default weekly
  // availability" rather than duplicating it onto every type.
  weeklyAvailability Json?

  bufferBeforeMinutes Int @default(0)
  bufferAfterMinutes  Int @default(0)

  minNoticeHours Int @default(12) // can't be booked less than this far in advance
  maxAdvanceDays Int @default(30) // can't be booked further out than this

  // Array of { id: string, label: string, required: boolean } — free-text
  // answers collected on the booking form. No question "types" beyond
  // free text — kept intentionally simple.
  intakeQuestions Json?

  // Confirmation email sent to the visitor right after booking. Null
  // subject/body falls back to a generic template in booking-notify.ts.
  confirmationSubject String?
  confirmationBody    String?

  // Hour-offsets before the meeting to send a reminder, e.g. [24, 1] for a
  // day-before and an hour-before reminder. Empty/null = no reminders.
  reminderHoursBefore Json?

  // Free text shown to the visitor (confirmation email + manage page) and
  // how much notice they must give to self-cancel. Null hours = no limit.
  cancellationPolicy   String?
  minCancelNoticeHours Int?
  allowRescheduling    Boolean @default(true)

  // When a booking of this type is made, advance the linked deal (existing
  // or newly created) to this pipeline stage — e.g. Discovery Call ->
  // DISCOVERY_SCHEDULED. Null = don't touch the deal's stage, just link it.
  relatedDealStage DealStage?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  bookings Booking[]
}

enum BookingStatus {
  CONFIRMED
  CANCELLED
  COMPLETED
  NO_SHOW
  RESCHEDULED // superseded by a newer booking — see rescheduledTo
}

model Booking {
  id     String        @id @default(cuid())
  status BookingStatus @default(CONFIRMED)

  // No @unique here, deliberately — see the partial unique index in the
  // migration SQL instead ("Booking_startsAt_active_key", WHERE status NOT
  // IN (CANCELLED, RESCHEDULED)). Prisma's schema language can't express a
  // *conditional* unique constraint, and a plain unconditional one is
  // actually wrong here: a cancelled or rescheduled booking's row is kept
  // (not deleted) for history, and a global unique constraint on startsAt
  // would mean that exact instant can never be booked again by anyone,
  // forever, the moment any booking has ever occupied it — even after it's
  // cancelled and the slot picker correctly shows it as free again. The
  // partial index guards two visitors racing for the same instant among
  // *currently-blocking* bookings only; a real read-then-write race for
  // two *different* (but buffer-overlapping) instants is separately closed
  // at the application layer by running the availability check + insert
  // inside a serializable transaction (see booking-engine.ts).
  startsAt DateTime
  endsAt   DateTime

  // startsAt/endsAt widened by the meeting type's buffers at creation
  // time — this is the actual range checked for overlap against other
  // bookings, so a back-to-back buffer requirement is enforced without
  // re-deriving it from the (possibly since-changed) meeting type on every
  // check.
  bufferedStartsAt DateTime
  bufferedEndsAt   DateTime

  name        String
  email       String
  companyName String? // as typed by the visitor, before any Company match/create
  notes       String?

  // Visitor's own timezone at booking time (IANA name, e.g.
  // "America/Los_Angeles") — collected from the browser on the public
  // form. Slots themselves are always generated in the owner's timezone;
  // this is what lets confirmation/reminder emails and the manage page
  // show the visitor their own local time instead.
  timezone String

  intakeAnswers Json? // { [questionId]: answer }

  // Set from a client-generated UUID resubmitted unchanged on retry —
  // lets a double-click or a network-retried form submission be detected
  // and treated as "already done" instead of creating a second booking.
  idempotencyKey String? @unique

  // Opaque, unguessable (crypto-random, see tokens.ts) reference mailed to
  // the visitor as their manage-booking link. Stored directly rather than
  // hashed like the password-reset token — unlike a password reset, this
  // needs to be reusable across the confirmation, reminder, and reschedule
  // emails sent over the life of one booking, and it only ever grants
  // self-service control over this one low-stakes appointment, not
  // account access.
  manageToken String? @unique

  createdAt DateTime @default(now())

  confirmationSentAt DateTime?
  internalNotifiedAt DateTime?
  // Array of hour-offsets (numbers) whose reminder has already gone out —
  // checked against MeetingType.reminderHoursBefore so a reminder is never
  // sent twice for the same booking, even though there's no scheduler and
  // this is instead swept lazily (see booking-notify.ts).
  remindersSent      Json?

  cancelledAt  DateTime?
  cancelReason String?

  completedAt DateTime?
  noShowAt    DateTime?

  // Self-relation: the booking THIS one replaced, if it was created via a
  // reschedule. Unique because a given old booking can be replaced by at
  // most one new one. The old booking's own row is kept (status set to
  // RESCHEDULED) rather than deleted, so its history/logs survive.
  rescheduledFromId String?  @unique
  rescheduledFrom   Booking? @relation("BookingReschedule", fields: [rescheduledFromId], references: [id], onDelete: SetNull)
  rescheduledTo     Booking? @relation("BookingReschedule")

  meetingType   MeetingType? @relation(fields: [meetingTypeId], references: [id], onDelete: SetNull)
  meetingTypeId String?

  contact   Contact? @relation(fields: [contactId], references: [id], onDelete: SetNull)
  contactId String?

  company   Company? @relation(fields: [companyId], references: [id], onDelete: SetNull)
  companyId String?

  deal   Deal?   @relation(fields: [dealId], references: [id], onDelete: SetNull)
  dealId String?

  logs BookingLog[]

  @@index([status, startsAt])
}

enum BookingLogType {
  CONFIRMATION_SENT
  REMINDER_SENT
  DELIVERY_FAILED
  BOOKING_CONFLICT
  DUPLICATE_PREVENTED
}

// Append-only audit trail for booking delivery/validation events — the
// "Add logs for" requirement. bookingId is nullable because a conflict or
// duplicate-prevented event happens *instead of* a booking being created,
// so there's sometimes no Booking row to attach to.
model BookingLog {
  id        String         @id @default(cuid())
  type      BookingLogType
  message   String
  createdAt DateTime       @default(now())

  booking   Booking? @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  bookingId String?

  @@index([type, createdAt])
}

// The 5 original values (NEW, CONTACTED, PROPOSAL, WON, LOST) expanded to an
// 11-stage pipeline. Existing rows are remapped on migration: NEW->NEW_LEAD,
// PROPOSAL->PROPOSAL_SENT, everything else keeps its name. Also used by
// Contact.pipelineStage and PipelineStageLabel.stage, both remapped the
// same way in the same migration.
enum DealStage {
  NEW_LEAD
  RESEARCHING
  READY_TO_CONTACT
  CONTACTED
  DISCOVERY_SCHEDULED
  DISCOVERY_COMPLETED
  PROPOSAL_SENT
  NEGOTIATION
  WON
  LOST
  NURTURE
}

model Deal {
  id    String    @id @default(cuid())
  title String
  stage DealStage @default(NEW_LEAD)

  // Money — tracked separately since a deal can carry both a setup fee and
  // an ongoing retainer at once; replaces the old value+isRecurring pair.
  oneTimeValue Float?
  mrrValue     Float?

  serviceInterest   String? // free text, autocompletes from ServiceType
  leadSource        String? // free text, matches Contact.leadSource's pattern
  probability       Int? // 0-100, manual estimate
  expectedCloseDate DateTime?

  // Stage tracking
  stageEnteredAt DateTime  @default(now()) // reset on every stage change; powers "days in stage"
  wonAt          DateTime? // set when stage first transitions to WON, kept stable — revenue reporting relies on this

  // Follow-through
  nextAction      String?
  nextActionDueAt DateTime?

  // Stage-gate inputs (see deals/deal-rules.ts for what each gate requires)
  decisionMaker    String? // primary decision-maker, required before Proposal Sent
  meetingDate      DateTime? // required before Discovery Scheduled (or a related Booking)
  startDate        DateTime? // required before Won
  billingMethod    BillingType? // required before Won
  proposalAccepted Boolean      @default(false) // confirmation/accepted proposal, required before Won
  lostReason       String? // required before Lost

  competitor String?
  notes      String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  contact   Contact? @relation(fields: [contactId], references: [id], onDelete: SetNull)
  contactId String?

  company   Company? @relation(fields: [companyId], references: [id], onDelete: SetNull)
  companyId String?

  assignedTo   User?   @relation(fields: [assignedToId], references: [id], onDelete: SetNull)
  assignedToId String?

  tasks       Task[]
  activities  Activity[]
  nextActions NextBestActionItem[]
  bookings    Booking[]
}

// OPEN/DONE expanded to a full workflow. Existing rows are remapped on
// migration: OPEN->READY, DONE->COMPLETED.
enum TaskStatus {
  BACKLOG
  READY
  IN_PROGRESS
  WAITING
  BLOCKED
  REVIEW
  COMPLETED
  CANCELLED
}

enum TaskRecurrence {
  NONE
  DAILY
  WEEKLY
  MONTHLY
  CUSTOM
}

model Task {
  id          String     @id @default(cuid())
  title       String
  description String? // was "notes" pre-Stage-4; renamed for clarity now that completionNotes exists separately
  startDate   DateTime?
  dueDate     DateTime?
  status      TaskStatus @default(READY)
  priority    Priority   @default(MEDIUM)
  labels      String? // comma-separated for simplicity, same pattern as Contact.tags
  progress    Int        @default(0) // 0-100

  recurrence             TaskRecurrence @default(NONE)
  recurrenceIntervalDays Int? // only meaningful when recurrence = CUSTOM
  // Guards against spawning more than one next-occurrence task if a
  // recurring task's status is toggled to Completed and back multiple times.
  nextInstanceCreated    Boolean        @default(false)

  estimatedMinutes Int? // time estimate
  trackedMinutes   Int  @default(0) // time logged so far, incremented via a simple "log time" control

  waitingReason String? // populated when status = WAITING
  blockedReason String? // populated when status = BLOCKED

  completionNotes       String?
  completionEvidenceUrl String? // link to a deployed page, doc, screenshot, etc. proving the work is done
  completedAt           DateTime?

  // Project-template flags (Stage 5). isQualityControl just marks the task
  // as a QC checkpoint for display; requiresEvidence is enforced server-
  // side — see tasks/actions.ts — a task can't be marked Completed without
  // completionEvidenceUrl set when this is true.
  isQualityControl Boolean @default(false)
  requiresEvidence Boolean @default(false)

  overdueNotified Boolean  @default(false) // guards the Task Overdue automation from re-firing
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  assignedTo   User?   @relation(fields: [assignedToId], references: [id], onDelete: SetNull)
  assignedToId String?

  contact   Contact? @relation(fields: [contactId], references: [id], onDelete: SetNull)
  contactId String?

  company   Company? @relation(fields: [companyId], references: [id], onDelete: SetNull)
  companyId String?

  deal   Deal?   @relation(fields: [dealId], references: [id], onDelete: SetNull)
  dealId String?

  project   Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  projectId String?

  invoice   Invoice? @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
  invoiceId String?

  attachments  Attachment[]
  checklist    TaskChecklistItem[]
  dependsOn    TaskDependency[]    @relation("TaskDependsOn")
  dependedOnBy TaskDependency[]    @relation("TaskDependedOnBy")
}

model TaskChecklistItem {
  id        String   @id @default(cuid())
  label     String
  done      Boolean  @default(false)
  createdAt DateTime @default(now())

  task   Task   @relation(fields: [taskId], references: [id], onDelete: Cascade)
  taskId String
}

// Explicit join model for "this task can't start until that task is done."
// dependsOnTaskId is the blocker; taskId is the task being blocked.
model TaskDependency {
  id String @id @default(cuid())

  task   Task   @relation("TaskDependsOn", fields: [taskId], references: [id], onDelete: Cascade)
  taskId String

  dependsOnTask   Task   @relation("TaskDependedOnBy", fields: [dependsOnTaskId], references: [id], onDelete: Cascade)
  dependsOnTaskId String

  createdAt DateTime @default(now())

  @@unique([taskId, dependsOnTaskId])
}

enum ActivityType {
  NOTE
  CALL
  EMAIL
  MEETING
  SMS
  FACEBOOK_MESSAGE
  DEMO
  PROPOSAL
}

model Activity {
  id         String       @id @default(cuid())
  type       ActivityType
  summary    String
  missed     Boolean      @default(false) // only meaningful when type is CALL
  occurredAt DateTime     @default(now())
  createdAt  DateTime     @default(now())

  contact   Contact? @relation(fields: [contactId], references: [id], onDelete: SetNull)
  contactId String?

  deal   Deal?   @relation(fields: [dealId], references: [id], onDelete: SetNull)
  dealId String?

  project   Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  projectId String?

  createdBy   User?   @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdById String?
}

enum KnowledgeCategory {
  SALES_SCRIPTS
  DISCOVERY_QUESTIONS
  SEO_SOPS
  AI_AUTOMATION_SOPS
  WEBSITE_SOPS
  PROPOSAL_TEMPLATES
  EMAIL_TEMPLATES
  PROMPT_LIBRARY
  OBJECTION_HANDLING
  BUSINESS_RESOURCES
}

enum KnowledgeArticleStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

// "BVD Internal" is never client-scoped. "Client Private"/"Client Shared"
// both require a clientId; the only difference is intended audience within
// the client relationship (private = internal-facing notes about a client,
// shared = content the client themselves may be shown) — both are equally
// excluded from every other client's retrieval. "Public" needs no clientId
// and is retrievable by any authenticated client.
enum KnowledgeArticleVisibility {
  BVD_INTERNAL
  CLIENT_PRIVATE
  CLIENT_SHARED
  PUBLIC
}

model KnowledgeArticle {
  id      String @id @default(cuid())
  title   String
  slug    String @unique
  summary String @default("")
  content String

  category KnowledgeCategory
  tags     String? // comma-separated, same convention as Contact.tags

  status     KnowledgeArticleStatus     @default(DRAFT)
  visibility KnowledgeArticleVisibility @default(BVD_INTERNAL)

  // Required when visibility is CLIENT_PRIVATE/CLIENT_SHARED, must be null
  // for BVD_INTERNAL/PUBLIC — enforced in code (see knowledge/actions.ts),
  // not at the DB level, since Prisma has no conditional-required columns.
  client   Contact? @relation(fields: [clientId], references: [id], onDelete: SetNull)
  clientId String?

  owner   User?   @relation(fields: [ownerId], references: [id], onDelete: SetNull)
  ownerId String?

  // Draft/Archived articles and aiEnabled=false articles are never eligible
  // for AI retrieval regardless of this flag — see knowledge-access.ts.
  aiEnabled Boolean @default(false)

  reviewDate  DateTime?
  publishedAt DateTime?
  archivedAt  DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  revisions   KnowledgeArticleRevision[]
  attachments Attachment[]

  @@index([status, visibility])
  @@index([clientId])
  @@index([category])
}

// Lightweight version history: one row per meaningful edit (title/content/
// summary change), snapshotted before the update is applied. Intentionally
// simple — no diffing, no restore-UI beyond "view" for v1, per the spec's
// explicit "do not let this delay essential functionality."
model KnowledgeArticleRevision {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  title   String
  summary String
  content String

  editedBy   User?   @relation(fields: [editedById], references: [id], onDelete: SetNull)
  editedById String?

  article   KnowledgeArticle @relation(fields: [articleId], references: [id], onDelete: Cascade)
  articleId String

  @@index([articleId])
}

// Audit trail for AI Assistant queries that could touch knowledge-article
// content, per the spec's logging requirement. Deliberately stores article
// IDs (not content) and a truncated response — never secrets.
model AiQueryLog {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)
  userId String?

  // The Contact (status=CLIENT) whose context the query was scoped to, if
  // any. Null means the query ran under BVD-internal/admin scope.
  clientContact   Contact? @relation(fields: [clientContactId], references: [id], onDelete: SetNull)
  clientContactId String?

  query               String
  articleIdsRetrieved String[] @default([])
  permissionScope     String // e.g. "bvd_admin" | "client:<id>"
  response            String
  error               String?

  @@index([userId])
  @@index([clientContactId])
}

enum GoalMetric {
  CALLS
  MEETINGS
  DEMOS
  PROPOSALS
  CLIENTS_CLOSED
  REVENUE
}

enum GoalPeriod {
  WEEKLY
  MONTHLY
}

model Goal {
  id        String     @id @default(cuid())
  metric    GoalMetric
  period    GoalPeriod
  target    Float      @default(0)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String

  @@unique([userId, metric, period])
}

enum AutomationTrigger {
  LEAD_CREATED
  PROPOSAL_SENT
  INVOICE_PAID
  WEBSITE_PUBLISHED
  CLIENT_SIGNED
  TASK_OVERDUE
  REVIEW_REQUEST
  MISSED_CALL
  APPOINTMENT_BOOKED
  APPOINTMENT_RESCHEDULED
  APPOINTMENT_CANCELLED
  APPOINTMENT_COMPLETED
  APPOINTMENT_NO_SHOW
}

enum AutomationActionType {
  CREATE_TASK
  SEND_EMAIL
  WEBHOOK
}

// Who a SEND_EMAIL action's message goes to. OWNER (the default, and the
// only option that previously existed) notifies the CRM owner. CONTACT
// sends to the contact linked to the triggering event instead — e.g. a
// booking confirmation the client themselves receives.
enum AutomationEmailRecipient {
  OWNER
  CONTACT
}

enum AutomationRunStatus {
  SUCCESS
  FAILED
}

model AutomationRule {
  id        String            @id @default(cuid())
  name      String
  trigger   AutomationTrigger
  enabled   Boolean           @default(true)
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  // A rule used to have exactly one action baked directly onto it
  // (actionType/taskTitle/.../webhookUrl fields). That's now AutomationAction
  // below — one rule can chain several actions (e.g. create a task AND email
  // the contact off the same trigger) instead of needing a separate rule per
  // action. See the 20260811050000 migration for how existing rules/runs
  // were carried over.
  actions AutomationAction[]
  runs    AutomationRun[]
}

// One step in a rule's action chain, run in `order`. Same per-type config
// fields the single-action AutomationRule used to hold, just scoped to one
// action instead of the whole rule.
model AutomationAction {
  id        String               @id @default(cuid())
  order     Int                  @default(0)
  actionType AutomationActionType
  createdAt DateTime             @default(now())

  // CREATE_TASK config
  taskTitle     String?
  taskDueInDays Int?

  // SEND_EMAIL config
  emailRecipient AutomationEmailRecipient @default(OWNER)
  emailSubject   String?
  emailBody      String?

  // WEBHOOK config
  webhookUrl String?

  rule   AutomationRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)
  ruleId String

  runs AutomationRun[]

  @@index([ruleId, order])
}

model AutomationRun {
  id        String              @id @default(cuid())
  status    AutomationRunStatus @default(SUCCESS)
  summary   String
  error     String?
  // Manual "Test this automation" runs from the detail page, as opposed to
  // a real trigger firing — kept separate so a test doesn't read as
  // evidence the automation is (or isn't) working in production.
  isTest    Boolean             @default(false)
  createdAt DateTime            @default(now())

  action   AutomationAction @relation(fields: [actionId], references: [id], onDelete: Cascade)
  actionId String
  // Denormalized alongside actionId so "all runs for this rule" doesn't
  // need to join through actions — kept in sync at write time since a run
  // is only ever created for one specific rule+action pair together.
  rule   AutomationRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)
  ruleId String
}

// Custom display label for one of the fixed DealStage values. The stage set
// itself (NEW/CONTACTED/PROPOSAL/WON/LOST) stays fixed since WON/LOST drive
// revenue and automation logic throughout the app — only the label is
// customizable.
model PipelineStageLabel {
  id    String    @id @default(cuid())
  stage DealStage @unique
  label String
}

// Suggested service names shown when adding a service to a client — services
// themselves stay free text, this just powers the autocomplete list.
model ServiceType {
  id        String   @id @default(cuid())
  name      String   @unique
  createdAt DateTime @default(now())
}

// Suggested task labels shown when tagging a task — Task.labels stays free
// text, this just powers the autocomplete list.
model TaskLabelPreset {
  id        String   @id @default(cuid())
  name      String   @unique
  createdAt DateTime @default(now())
}

enum NBAPriority {
  CRITICAL
  HIGH
  MEDIUM
  LOW
}

enum NBAStatus {
  ACTIVE
  SNOOZED
  COMPLETED
  DISMISSED
}

// A persisted Next Best Action recommendation. Generated by deterministic
// rules (see actions/rules.ts) and synced on read (actions/sync.ts) rather
// than on a schedule — there's no background job runner in this app, so a
// recommendation's freshness is only guaranteed as of the last time the
// Dashboard or the Next Actions page was loaded.
//
// dedupeKey identifies "this class of recommendation for this entity" and
// is unique — there is at most one row per (category, entity) at a time.
// conditionSignature captures the mutable facts behind the recommendation
// (e.g. the exact due date); the sync only reactivates a DISMISSED or
// COMPLETED row when the signature has changed, which is what keeps a
// dismissed recommendation from reappearing on every page load.
model NextBestActionItem {
  id                 String      @id @default(cuid())
  dedupeKey          String      @unique
  conditionSignature String
  category           String
  priority           NBAPriority
  reason             String
  recommendedAction  String
  dueDate            DateTime?
  href               String
  status             NBAStatus   @default(ACTIVE)

  snoozedUntil DateTime?
  completedAt  DateTime?
  dismissedAt  DateTime?

  contact   Contact? @relation(fields: [contactId], references: [id], onDelete: Cascade)
  contactId String?

  company   Company? @relation(fields: [companyId], references: [id], onDelete: Cascade)
  companyId String?

  deal   Deal?   @relation(fields: [dealId], references: [id], onDelete: Cascade)
  dealId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, priority])
  @@index([dueDate])
}

// Configurable "days in stage before it's flagged as stuck" per DealStage,
// used by the deal-stuck-in-stage Next Best Action rule. Only the 9
// stages with a fixed day threshold get a row here — Discovery Scheduled
// (judged against its meeting date) and Nurture (judged against its next
// follow-up date) are handled in code and never get a row.
model PipelineStageThreshold {
  stage DealStage @id
  days  Int
}
